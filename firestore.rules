rules_version = '2';

/**
 * Security Rules — CrossFit Black Street
 *
 * Qui sta TUTTA la sicurezza del backend: la config Firebase nel JavaScript è
 * pubblica per design, quindi chiunque può parlare con Firestore. Ciò che può
 * fare lo decidono solo queste regole.
 *
 * Deploy:  firebase deploy --only firestore:rules
 * Test:    Console Firebase → Firestore → Regole → Playground
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------------------------------- *
     * Helper
     * ---------------------------------------------------------------- */

    // UID del proprietario. È scritto qui dentro di proposito: nessun documento
    // di database può cambiarlo, quindi nessun admin — per quanto malintenzionato
    // o compromesso — può rimuovere il proprietario o prenderne il posto.
    // Per cambiare proprietario si modifica questa riga e si ripubblicano le regole.
    // Deve restare allineato a OWNER_UID in js/firebase/config.js.
    function ownerUid() {
      return 'qWsn00kgiQb8ZbnSYOqcP6XvtFt2';
    }

    function isOwner() {
      return request.auth != null && request.auth.uid == ownerUid();
    }

    // È admin chi è autenticato E ha un documento in /admins con il proprio UID.
    // Quel documento nasce in due modi: creato a mano dalla console (il primo,
    // il proprietario), oppure auto-creato da chi accetta un invito valido.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Email verificata dal provider. Google la verifica sempre; un account
    // email/password no, finché non conferma il messaggio ricevuto.
    // Senza questo controllo si potrebbe registrare un account con l'indirizzo
    // di un invitato, senza avere accesso alla sua casella, e rubargli l'invito.
    function verifiedEmail() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isString(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    // Un socio è "attivo" solo dopo l'approvazione manuale di un admin:
    // tesseramento e certificato medico sono obbligatori, e nessun controllo
    // automatico può sostituire quella verifica.
    function memberStatus() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status;
    }

    function isActiveMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && memberStatus() == 'active';
    }

    /* ---------------------------------------------------------------- *
     * /admins — elenco degli amministratori
     * ---------------------------------------------------------------- */
    match /admins/{uid} {
      // Ognuno vede il proprio stato; gli admin vedono l'elenco completo del team.
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());

      // Accettazione di un invito: l'utente crea il documento SOLO per sé stesso
      // e solo se esiste un invito intestato alla sua email verificata.
      // Non esiste alcun percorso per crearlo a nome di qualcun altro.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && verifiedEmail()
        && exists(/databases/$(database)/documents/invites/$(myEmail()))
        && request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email == myEmail()
        && request.resource.data.createdAt is timestamp;

      // Nessuna modifica dopo la creazione: non c'è nulla di modificabile che
      // non sia un tentativo di scalata di privilegi.
      allow update: if false;

      // Solo il proprietario revoca un accesso, e mai il proprio.
      // `uid != ownerUid()` è la riga che rende il proprietario inamovibile.
      allow delete: if isOwner() && uid != ownerUid();
    }

    /* ---------------------------------------------------------------- *
     * /invites — inviti in attesa, indicizzati per email
     * ---------------------------------------------------------------- *
     * L'ID del documento È l'email invitata, in minuscolo. Serve perché la
     * regola di /admins possa cercarla con exists() in un colpo solo: le
     * regole non sanno fare query, sanno solo controllare se un percorso
     * esiste.
     */
    match /invites/{email} {
      allow read: if isAdmin();

      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['email', 'invitedBy', 'createdAt'])
        // L'ID del documento deve coincidere con il campo email, altrimenti
        // l'invito sarebbe irraggiungibile dal controllo di /admins.
        && request.resource.data.email == email
        && isString(email, 5, 120)
        && email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && isString(request.resource.data.invitedBy, 1, 120)
        && request.resource.data.createdAt is timestamp;

      allow update: if false;

      // Il proprietario revoca un invito; l'invitato lo consuma accettandolo.
      allow delete: if isOwner()
        || (verifiedEmail() && myEmail() == email);
    }

    /* ---------------------------------------------------------------- *
     * /events — bacheca eventi
     * ---------------------------------------------------------------- */
    match /events/{eventId} {

      function validEvent() {
        let d = request.resource.data;
        return d.keys().hasOnly([
                 'title', 'badge', 'date', 'time', 'description',
                 'workout', 'info', 'featured', 'published',
                 'sortIndex', 'createdAt', 'updatedAt'
               ])
          && isString(d.title, 1, 80)
          && isString(d.get('badge', ''), 0, 40)
          && isString(d.get('date', ''), 0, 60)
          && isString(d.get('time', ''), 0, 40)
          && isString(d.get('description', ''), 0, 600)
          && isString(d.get('info', ''), 0, 200)
          && d.get('workout', []) is list
          && d.get('workout', []).size() <= 20
          && d.get('featured', false) is bool
          && d.published is bool
          && d.get('sortIndex', 0) is int;
      }

      // Il pubblico vede solo gli eventi pubblicati; l'admin vede anche le bozze.
      // Nota: le regole non filtrano, valutano. Per questo il sito interroga
      // Firestore con una query `where published == true` (vedi js/firebase/rest.js):
      // una lettura non filtrata verrebbe rifiutata in blocco.
      allow read: if resource.data.published == true || isAdmin();

      allow create, update: if isAdmin() && validEvent();
      allow delete: if isAdmin();
    }

    /* ---------------------------------------------------------------- *
     * /leads — richieste dal form di contatto
     * ---------------------------------------------------------------- */
    match /leads/{leadId} {

      function validLead() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'email', 'message', 'source', 'createdAt'])
          && isString(d.name, 2, 80)
          && isString(d.email, 5, 120)
          && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
          && isString(d.message, 10, 2000)
          && isString(d.source, 1, 40)
          // Timestamp coerente con l'orologio del server: impedisce di
          // riempire la collection con date arbitrarie, passate o future.
          && d.createdAt is timestamp
          && d.createdAt < request.time + duration.value(5, 'm')
          && d.createdAt > request.time - duration.value(1, 'h');
      }

      // Chiunque può inviare una richiesta, nessuno può rileggerle:
      // gli indirizzi email dei clienti non devono essere pubblici.
      allow create: if validLead();
      allow read, update, delete: if isAdmin();
    }

    /* ---------------------------------------------------------------- *
     * /users — soci registrati
     * ---------------------------------------------------------------- */
    match /users/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // Registrazione: il socio crea il proprio profilo, e nasce SEMPRE in
      // stato 'pending'. La riga `status == 'pending'` è ciò che impedisce di
      // auto-approvarsi e prenotare senza certificato medico.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && verifiedEmail()
        && request.resource.data.keys().hasOnly([
             'name', 'email', 'phone', 'status', 'createdAt', 'certStatus', 'certUploadedAt'
           ])
        && request.resource.data.get('certStatus', 'none') in ['none', 'pending']
        && request.resource.data.status == 'pending'
        && request.resource.data.email == myEmail()
        && isString(request.resource.data.name, 2, 80)
        && isString(request.resource.data.get('phone', ''), 0, 30)
        && request.resource.data.createdAt is timestamp;

      // Due scritture possibili, e nessuna delle due si sovrappone all'altra:
      // il socio corregge i propri dati, l'admin cambia lo stato.
      // Lo stato del certificato vive QUI e non nel documento del certificato
      // perché il pannello elenca tutti i soci: se ogni riga trascinasse con sé
      // il blob base64 del documento, aprire l'elenco scaricherebbe decine di
      // megabyte. Qui restano solo i metadati; il file si carica su richiesta.
      allow update: if request.auth != null && (
        (
          request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'phone', 'certStatus', 'certUploadedAt'])
          && isString(request.resource.data.get('name', ''), 2, 80)
          && isString(request.resource.data.get('phone', ''), 0, 30)
          // Caricare un documento lo rimette in attesa di verifica: il socio
          // non può dichiarare approvato il proprio certificato.
          && request.resource.data.get('certStatus', 'none') == 'pending'
        ) || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'certStatus', 'certExpiresAt', 'certNote'])
          && request.resource.data.get('status', 'pending') in ['pending', 'active', 'blocked']
          && request.resource.data.get('certStatus', 'none') in ['none', 'pending', 'approved', 'rejected']
        )
      );

      allow delete: if isAdmin();
    }

    /* ---------------------------------------------------------------- *
     * /certificates — certificato medico, salvato come base64
     * ---------------------------------------------------------------- *
     * Firebase Storage richiede il piano a pagamento, quindi il documento sta
     * dentro Firestore. Il limite di 1 MiB per documento non è aggirabile: il
     * client comprime le immagini e le regole qui sotto rifiutano ciò che
     * non entrerebbe comunque.
     *
     * Un documento per socio, con l'UID come ID: un ricaricamento sostituisce
     * il precedente invece di accumulare copie del certificato in giro.
     */
    match /certificates/{uid} {

      function validUpload() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'fileName', 'contentType', 'size', 'data', 'status', 'uploadedAt'])
          && d.uid == uid
          // Sempre 'pending': la verifica è di un umano.
          && d.status == 'pending'
          && d.contentType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf']
          && isString(d.fileName, 1, 160)
          && d.size is int && d.size > 0 && d.size <= 716800
          // 960.000 caratteri di base64 lasciano margine sotto il tetto di 1 MiB
          // una volta contati gli altri campi.
          && d.data is string && d.data.size() > 0 && d.data.size() <= 960000
          && d.uploadedAt is timestamp;
      }

      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // Nessun elenco: i certificati si aprono uno alla volta, mai in blocco.
      allow list: if false;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && verifiedEmail()
        && validUpload();

      // Il socio sostituisce il proprio documento; l'esito della verifica lo
      // scrive l'admin nel profilo, non qui.
      allow update: if request.auth != null && request.auth.uid == uid && validUpload();

      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    /* ---------------------------------------------------------------- *
     * /sessions — singole occorrenze di classe, con contatore posti
     * ---------------------------------------------------------------- *
     * ID deterministico: 2026-08-26_0930_CF. Serve a rendere la generazione
     * del calendario ripetibile senza creare doppioni.
     *
     * `booked` è un contatore denormalizzato. Non è un'ottimizzazione: le
     * Security Rules non sanno contare documenti, quindi il limite dei posti
     * può essere imposto solo confrontando un numero con un altro numero.
     */
    match /sessions/{sessionId} {

      function bookingRef() {
        return /databases/$(database)/documents/bookings/$(request.auth.uid + '_' + sessionId);
      }

      function waitRef() {
        return /databases/$(database)/documents/waitlist/$(request.auth.uid + '_' + sessionId);
      }

      // Scorciatoie: `after` è come sarà il documento, `before` com'è adesso.
      function after() { return request.resource.data; }
      function before() { return resource.data; }

      function changes(keys) {
        return after().diff(before()).affectedKeys().hasOnly(keys);
      }

      function bookable() {
        return before().startsAt > request.time
          && before().get('cancelled', false) == false;
      }

      /* --- prenotazione diretta: c'è posto e nessuno è in coda --- */
      function takesSeat() {
        return isActiveMember()
          && changes(['booked'])
          && bookable()
          && after().booked == before().booked + 1
          && after().booked <= before().capacity
          // Se qualcuno è in lista d'attesa, il posto liberato è suo: chi
          // arriva dopo non può scavalcarlo semplicemente ricaricando.
          && before().get('waiting', 0) == 0
          && existsAfter(bookingRef());
      }

      /* --- prenotazione da lista d'attesa: si prende il posto e si esce dalla coda --- */
      function takesSeatFromWaitlist() {
        return isActiveMember()
          && changes(['booked', 'waiting'])
          && bookable()
          && after().booked == before().booked + 1
          && after().booked <= before().capacity
          && after().waiting == before().waiting - 1
          && after().waiting >= 0
          && exists(waitRef())        // c'ero davvero
          && !existsAfter(waitRef())  // e me ne sono tolto
          && existsAfter(bookingRef());
      }

      /* --- disdetta: il posto torna libero ---
         `exists(bookingRef())` non è pignoleria: senza, chiunque potrebbe
         abbassare il contatore di una classe a cui non è iscritto, facendola
         risultare libera e portandola in overbooking. */
      function releasesSeat() {
        return request.auth != null
          && changes(['booked'])
          && after().booked == before().booked - 1
          && after().booked >= 0
          && exists(bookingRef())
          && !existsAfter(bookingRef());
      }

      /* --- lista d'attesa: ci si entra solo a classe piena --- */
      function joinsWaitlist() {
        return isActiveMember()
          && changes(['waiting'])
          && bookable()
          && after().waiting == before().get('waiting', 0) + 1
          && before().booked >= before().capacity
          && !exists(bookingRef())    // chi è già dentro non si mette in coda
          && existsAfter(waitRef());
      }

      function leavesWaitlist() {
        return request.auth != null
          && changes(['waiting'])
          && after().waiting == before().waiting - 1
          && after().waiting >= 0
          && exists(waitRef())
          && !existsAfter(waitRef());
      }

      /* --- interventi dello staff --- */
      function adminAdjusts() {
        return isAdmin()
          && changes(['capacity', 'cancelled', 'booked', 'waiting'])
          && after().get('capacity', 1) is int
          && after().get('capacity', 1) >= after().get('booked', 0)
          && after().get('cancelled', false) is bool
          && after().get('booked', 0) >= 0
          && after().get('waiting', 0) >= 0;
      }

      function validSession() {
        let d = request.resource.data;
        return d.keys().hasOnly([
                 'startsAt', 'type', 'capacity', 'booked', 'waiting', 'cancelled', 'createdAt'
               ])
          && d.startsAt is timestamp
          && d.type in ['CF', 'HYROX']
          && d.capacity is int && d.capacity > 0 && d.capacity <= 200
          && d.booked is int && d.booked == 0
          && d.get('waiting', 0) is int && d.get('waiting', 0) == 0
          && d.get('cancelled', false) == false;
      }

      // Il calendario con i posti liberi è informazione pubblica: non contiene
      // dati personali e permette di mostrare la disponibilità anche in home.
      allow read: if true;

      allow create: if isAdmin() && validSession();
      // Una classe futura con iscritti non si cancella, si annulla: chi ha
      // prenotato deve poterlo vedere invece di trovare il vuoto.
      // Una classe passata invece si elimina, iscritti compresi: è la pulizia
      // dell'archivio oltre il periodo di conservazione.
      allow delete: if isAdmin()
        && (resource.data.booked == 0 || resource.data.startsAt < request.time);

      allow update: if takesSeat()
        || takesSeatFromWaitlist()
        || releasesSeat()
        || joinsWaitlist()
        || leavesWaitlist()
        || adminAdjusts();
    }

    /* ---------------------------------------------------------------- *
     * /bookings — prenotazioni
     * ---------------------------------------------------------------- *
     * ID deterministico {uid}_{sessionId}: rende impossibile prenotare due
     * volte la stessa classe, senza bisogno di alcuna query.
     */
    match /bookings/{bookingId} {

      function sessionRef(sid) {
        return /databases/$(database)/documents/sessions/$(sid);
      }

      allow get, list: if request.auth != null
        && (isAdmin() || resource.data.uid == request.auth.uid);

      allow create: if isActiveMember()
        && bookingId == request.auth.uid + '_' + request.resource.data.sessionId
        && request.resource.data.keys().hasOnly([
             'uid', 'sessionId', 'userName', 'userEmail', 'startsAt', 'type', 'createdAt'
           ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userEmail == myEmail()
        && isString(request.resource.data.userName, 2, 80)
        && request.resource.data.startsAt is timestamp
        && request.resource.data.createdAt is timestamp
        // Il contatore DEVE essere salito nella stessa transazione: è questo
        // che rende impossibile prenotare oltre la capienza.
        && getAfter(sessionRef(request.resource.data.sessionId)).data.booked
             == get(sessionRef(request.resource.data.sessionId)).data.booked + 1;

      // Nulla è modificabile: si disdice e si riprenota.
      allow update: if false;

      // Termine per la disdetta: due ore. Chi molla all'ultimo momento lascia
      // un posto che nessuno può più prendere, e la lista d'attesa non fa in
      // tempo a scorrere. Lo staff può sempre intervenire.
      // Tenere allineato a CANCEL_CUTOFF_HOURS in js/firebase/config.js.
      function cancelCutoff() {
        return duration.value(2, 'h');
      }

      // Il posto va restituito nella stessa operazione: senza questo vincolo
      // il corso resterebbe pieno di prenotazioni cancellate.
      function seatGivenBack() {
        return getAfter(sessionRef(resource.data.sessionId)).data.booked
            == get(sessionRef(resource.data.sessionId)).data.booked - 1;
      }

      allow delete: if request.auth != null && (
        // il socio disdice, entro il termine
        (resource.data.uid == request.auth.uid
         && resource.data.startsAt > request.time + cancelCutoff()
         && seatGivenBack())
        // lo staff toglie un iscritto da una classe futura
        || (isAdmin() && resource.data.startsAt > request.time && seatGivenBack())
        // pulizia dell'archivio: la classe è passata e sparisce con tutto il
        // resto, quindi non c'è nessun contatore da aggiornare
        || (isAdmin() && resource.data.startsAt < request.time)
      );
    }

    /* ---------------------------------------------------------------- *
     * /waitlist — chi aspetta un posto in una classe piena
     * ---------------------------------------------------------------- *
     * ID composto {uid}_{sessionId} come per le prenotazioni: rende
     * impossibile mettersi due volte in coda per la stessa classe.
     *
     * Nota su come funziona davvero: quando un posto si libera, NON viene
     * assegnato automaticamente al primo della coda — servirebbe un server che
     * scriva a nome di qualcun altro, e lasciar scrivere un client per conto
     * terzi aprirebbe un buco molto più grande del problema che risolve.
     * Le regole fanno una cosa più semplice e altrettanto utile: finché
     * `waiting > 0`, il posto libero può prenderlo **solo** chi è in coda.
     * Fra loro vale l'ordine di arrivo sul pulsante, non quello di iscrizione.
     */
    match /waitlist/{entryId} {

      function sessionRef(sid) {
        return /databases/$(database)/documents/sessions/$(sid);
      }

      allow get, list: if request.auth != null
        && (isAdmin() || resource.data.uid == request.auth.uid);

      allow create: if isActiveMember()
        && entryId == request.auth.uid + '_' + request.resource.data.sessionId
        && request.resource.data.keys().hasOnly([
             'uid', 'sessionId', 'userName', 'userEmail', 'startsAt', 'type', 'joinedAt'
           ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userEmail == myEmail()
        && isString(request.resource.data.userName, 2, 80)
        && request.resource.data.startsAt is timestamp
        && request.resource.data.joinedAt is timestamp
        // Il contatore deve salire nella stessa transazione, altrimenti la
        // coda esisterebbe senza che nessuno lo sappia.
        && getAfter(sessionRef(request.resource.data.sessionId)).data.waiting
             == get(sessionRef(request.resource.data.sessionId)).data.get('waiting', 0) + 1;

      allow update: if false;

      // Si esce dalla coda per due motivi: rinuncia, oppure perché si è preso
      // il posto. In entrambi i casi il contatore deve scendere.
      allow delete: if request.auth != null && (
        ((isAdmin() || resource.data.uid == request.auth.uid)
         && getAfter(sessionRef(resource.data.sessionId)).data.waiting
              == get(sessionRef(resource.data.sessionId)).data.waiting - 1)
        // pulizia dell'archivio, come per le prenotazioni
        || (isAdmin() && resource.data.startsAt < request.time)
      );
    }

    /* ---------------------------------------------------------------- *
     * Tutto il resto è chiuso.
     * ---------------------------------------------------------------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
